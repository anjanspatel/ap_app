# Copy to .env and fill in for your deployment.

# The exact origin your frontend is served from — used for CORS.
FRONTEND_ORIGIN=https://app.anjanpatel.ca

# Port the Express server listens on (Render sets this automatically).
PORT=3001

# Where the SQLite database file lives. On Render, point this at your
# persistent disk mount, e.g. /data/data.sqlite — otherwise the file is
# lost on every redeploy.
DB_PATH=./data.sqlite

# Resend API key for password-reset emails. Leave unset during local
# development — reset links are logged to the console instead.
RESEND_API_KEY=
RESET_EMAIL_FROM=AP Workspace <noreply@anjanpatel.ca>

# Only needed once, to run migrate-from-supabase.js. Find this in your
# Supabase dashboard: Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

NODE_ENV=development
